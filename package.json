{
  "name": "nalatoon-motion-3d",
  "version": "1.0.0",
  "description": "3D Diorama vertical motion graphics studio (Remotion + Three.js + Qwen3-TTS MLX + YouTube Shorts Auto-Uploader)",
  "private": true,
  "scripts": {
    "ui": "node web-studio/start.mjs",
    "ui:build": "vite build --config web-studio/vite.config.ts",
    "lint:slop": "node scripts/lint-antislop.mjs",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit && tsc -p web-studio/tsconfig.json --noEmit",
    "render:padibebek": "node scripts/render/render_short.mjs PadiBebekShort",
    "render:minapadi": "node scripts/render/render_short.mjs MinaPadiShort",
    "render:tambora": "node scripts/render/render_short.mjs TamboraShort",
    "render:pulaurun": "node scripts/render/render_short.mjs PulauRunShort",
    "render:jawa": "node scripts/render/render_short.mjs JawaShort",
    "render:bahasajawa": "node scripts/render/render_short.mjs BahasaJawaShort"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "@remotion/cli": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/three": "4.0.529",
    "lucide-react": "^0.460.0",
    "postprocessing": "6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.529",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "5.7.3",
    "vite": "^5.4.11"
  }
}
