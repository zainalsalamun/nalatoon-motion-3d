  "scenes": [
    {
      "id": 1,
      "key": "hook_payday",
      "sceneStartSec": 0.0,
      "sceneEndSec": 4.174,
      "sceneStartFrame": 0,
      "sceneEndFrame": 125,
      "voStartSec": 0.35,
      "voEndSec": 4.014,
      "spoken": "Mekari bermasalah saat periode gajian. Sebenarnya, apa yang terjadi?"
    },
    {
      "id": 2,
      "key": "timeline_news",
      "sceneStartSec": 4.174,
      "sceneEndSec": 10.482,
      "sceneStartFrame": 125,
      "sceneEndFrame": 314,
      "voStartSec": 4.334,
      "voEndSec": 10.322,
      "spoken": "Pada dua puluh lima November, pengguna melaporkan kesulitan mengakses layanan. Media juga memberitakan gangguan pencairan gaji."
    },
    {
      "id": 3,
      "key": "official_notice",
      "sceneStartSec": 10.482,
      "sceneEndSec": 16.919,
      "sceneStartFrame": 314,
      "sceneEndFrame": 508,
      "voStartSec": 10.642,
      "voEndSec": 16.759,
      "spoken": "Dalam pembaruan resmi keesokan paginya, Mekari menyebut aktivitas tidak wajar yang diduga sebagai upaya serangan siber."
    },
    {
      "id": 4,
      "key": "isolation_gate",
      "sceneStartSec": 16.919,
      "sceneEndSec": 23.124,
      "sceneStartFrame": 508,
      "sceneEndFrame": 694,
      "voStartSec": 17.079,
      "voEndSec": 22.964,
      "spoken": "Sistem dinonaktifkan untuk mencegah pergerakan data. Jadi, layanan yang berhenti juga bagian dari langkah penanganan."
    },
    {
      "id": 5,
      "key": "new_infra",
      "sceneStartSec": 23.124,
      "sceneEndSec": 31.666,
      "sceneStartFrame": 694,
      "sceneEndFrame": 950,
      "voStartSec": 23.284,
      "voEndSec": 31.506,
      "spoken": "Mekari membangun infrastruktur baru, terpisah dari sistem lama. Targetnya siap dalam dua puluh empat jam, lalu layanan dipulihkan bertahap setelah verifikasi keamanan."
    },
    {
      "id": 6,
      "key": "data_check",
      "sceneStartSec": 31.666,
      "sceneEndSec": 36.485,
      "sceneStartFrame": 950,
      "sceneEndFrame": 1095,
      "voStartSec": 31.826,
      "voEndSec": 36.325,
      "spoken": "Apakah data bocor? Pengumuman resmi yang kami baca belum memastikan ada atau tidaknya kebocoran."
    },
    {
      "id": 7,
      "key": "safety_outro",
      "sceneStartSec": 36.485,
      "sceneEndSec": 46.472,
      "sceneStartFrame": 1095,
      "sceneEndFrame": 1394,
      "voStartSec": 36.645,
      "voEndSec": 43.672,
      "spoken": "Untuk bantuan, gunakan kanal resmi. Jangan berikan kata sandi, kode O T P, atau data penggajian lewat pesan yang mengatasnamakan Mekari."
    }
  ],
