# YouTube Auto-Uploader configuration (copy to .env and fill in locally)
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_TITLE=nalatoon
YOUTUBE_QUEUE_DIR=./queue
YOUTUBE_CLIENT_SECRET=./secrets/client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json

# Optional: Apple Silicon MLX Qwen3-TTS settings
MLX_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-8bit
MLX_REF_AUDIO=./assets/brand/voice_ref.wav
MLX_REF_TEXT=./assets/brand/voice_ref.txt
